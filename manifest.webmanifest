{
  "name": "ImageXpert",
  "short_name": "ImageXpert",
  "version": "1.2.0",
  "description": "Reverse image search hub with batch dispatch, local hashes, preprocessing, and companion right-click search.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#071015",
  "theme_color": "#0d171e",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "image"
    }
  }
}
